/- ============ 一、用 `def` 写定义（把 sorry 换掉）============ -/

/-- 题 1：声明常量 `myNat`，类型 `Nat`，值 `7`。 -/
def myNat : Nat :=
  sorry

/-- 题 2：声明常量 `myBool`，类型 `Bool`，值 `true`。 -/
def myBool : Bool :=
  sorry

/-- 题 3：声明常量 `seven`，类型 `Nat`，让它等于 `3 + 4`。
    要求：写算式 `3 + 4`，**不要**直接写 `7`。 -/
def seven : Nat :=
  sorry


/- ============ 二、预测（先写预测，再看答案）============ -/

/- 题 4：下面这一行会打印什么？

      #check myNat

    我的预测： -/


/- 题 5：下面这一行会打印什么？

      #eval seven + 1

    我的预测： -/


